{
  "name": "polcv",
  "version": "1.1.0",
  "private": true,
  "description": "Local, ATS-friendly CV generator tailored to a job posting, with ATS and AI scoring",
  "license": "MIT",
  "author": "BoroMat",
  "type": "module",
  "engines": {
    "node": "^24 || >=26"
  },
  "scripts": {
    "dev": "concurrently -k -n server,client -c blue,green \"tsx watch server/index.ts\" \"vite\"",
    "build": "vite build",
    "start": "tsx server/index.ts",
    "setup": "npm install && npx playwright install chromium && npm run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/source-sans-3": "^5.3.1",
    "@mozilla/readability": "^0.6.0",
    "cheerio": "^1.2.0",
    "express": "^5.3.0",
    "linkedom": "^0.18.15",
    "mammoth": "^1.13.0",
    "multer": "^2.5.0",
    "nanoid": "^6.0.2",
    "playwright": "^1.64.1",
    "tsx": "^4.23.15",
    "unpdf": "^2.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "concurrently": "^10.0.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
